# Copie este arquivo para .env e preencha.
# O .env NUNCA vai para o Git (veja o .gitignore).

OPENAI_API_KEY=coloque-sua-chave-aqui

OPENAI_MODEL=gpt-4o-mini

# 0.0 = objetivo e previsível | 1.0 = criativo e variado
AGENTE_TEMPERATURA=0.7

# Quantas rodadas de ferramenta o agente pode fazer antes de responder.
AGENTE_MAX_ITERACOES=5
