# Copie para .env — SÓ PARA RODAR NA SUA MÁQUINA.
#
# No Azure este arquivo não existe: o Container App recebe cada um destes
# valores como variável de ambiente, e a chave vem do Key Vault.
# O .dockerignore garante que o .env nunca entre na imagem.

# --- Foundry ---------------------------------------------------------------
# Só o host, sem caminho. O código normaliza se você colar a URL completa.
AZURE_FOUNDRY_ENDPOINT=https://SEU-RECURSO.services.ai.azure.com

# NOME DO DEPLOYMENT (o que você escolheu ao implantar), não o nome do modelo.
AZURE_FOUNDRY_DEPLOYMENT=gpt-5o-mini

# --- Autenticação ----------------------------------------------------------
# "entra"  = identidade (Managed Identity na nuvem, `az login` aqui). PADRÃO.
# "chave"  = força o uso da chave. Use só para depurar.
AZURE_FOUNDRY_AUTH=entra

# Fallback. Deixe VAZIO se você quer garantir que está usando identidade —
# assim, se a identidade falhar, o app falha em vez de mascarar o problema.
# No Azure este valor vem do Key Vault, não daqui.
AZURE_FOUNDRY_API_KEY=

# --- Application Insights ---------------------------------------------------
# Vazio na sua máquina = telemetria desligada, aplicação roda igual.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Preços do SEU modelo, por 1 milhão de tokens, para o custo estimado.
# Consulte a página de preços do Azure OpenAI. Deixados em 0 de propósito:
# número inventado em painel de custo é pior que painel nenhum.
EVA_PRECO_ENTRADA_POR_1M=0
EVA_PRECO_SAIDA_POR_1M=0

# --- Comportamento do agente ------------------------------------------------
EVA_TEMPERATURA=0.7
EVA_MAX_ITERACOES=5
