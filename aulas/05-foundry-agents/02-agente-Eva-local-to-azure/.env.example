# Copie para .env e preencha com os dados do SEU recurso no Microsoft Foundry.
# Onde achar cada valor: veja o GUIA-AI-FOUNDRY.md.

# --- endpoint do recurso (sem barra no fim) --------------------------------
# Portal do Foundry > seu deployment > "Endpoint".
# Use só a parte do host, sem /openai/v1/ — o código acrescenta isso.
AZURE_FOUNDRY_ENDPOINT=https://SEU-RECURSO.openai.azure.com

# --- QUAL MODELO USAR ------------------------------------------------------
# Este é o NOME DO DEPLOYMENT que VOCÊ escolheu ao implantar o modelo,
# não o nome do modelo. Se você implantou o gpt-4o-mini com o nome
# "eva-prod", aqui vai "eva-prod".
AZURE_FOUNDRY_DEPLOYMENT=gpt-4o-mini

# --- autenticação: "chave" ou "entra" --------------------------------------
AZURE_FOUNDRY_AUTH=chave

# Só é usada quando AZURE_FOUNDRY_AUTH=chave.
# Portal do Foundry > seu deployment > "Key".
AZURE_FOUNDRY_API_KEY=cole-sua-chave-aqui

# Com AZURE_FOUNDRY_AUTH=entra você NÃO precisa de chave nenhuma:
# basta rodar `az login` antes. Requer o pacote azure-identity e a
# role "Cognitive Services OpenAI User" no recurso.

# --- comportamento do agente -----------------------------------------------
EVA_TEMPERATURA=0.7
EVA_MAX_ITERACOES=5
