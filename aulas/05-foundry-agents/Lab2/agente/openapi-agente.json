{
  "openapi": "3.1.0",
  "info": {
    "title": "Serviço de Continuidade do Deva",
    "description": "Memória e fila do agente Deva. O agente LÊ a memória, LÊ a fila, AVANÇA documentos e PROPÕE regras novas. Aprovar propostas e liberar exceções são operações de auditor humano e não fazem parte desta especificação de propósito.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://SUA-URL"
    }
  ],
  "paths": {
    "/memoria": {
      "get": {
        "tags": [
          "memória"
        ],
        "summary": "Ler a memória aprovada",
        "description": "O agente chama isto no início de TODA sessão, antes de olhar qualquer documento.",
        "operationId": "obter_memoria_memoria_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Memoria"
                }
              }
            }
          }
        }
      }
    },
    "/memoria/proposta": {
      "post": {
        "tags": [
          "memória"
        ],
        "summary": "Propor uma regra nova",
        "description": "O agente chama isto quando o auditor o corrige. A regra NÃO passa a valer: entra numa fila de revisão.",
        "operationId": "propor_memoria_proposta_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntradaDeProposta"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropostaDeMemoria"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/fila": {
      "get": {
        "tags": [
          "fila"
        ],
        "summary": "O que há para fazer agora",
        "description": "O agente chama isto para descobrir trabalho sem ninguém pedir. Repare em 'aguardando_humano': isso NÃO é com ele.",
        "operationId": "resumo_da_fila_fila_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumoDaFila"
                }
              }
            }
          }
        }
      }
    },
    "/fila/documentos/{identificador}": {
      "get": {
        "tags": [
          "fila"
        ],
        "summary": "Obter Documento",
        "operationId": "obter_documento_fila_documentos__identificador__get",
        "parameters": [
          {
            "name": "identificador",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Identificador"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Documento"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/fila/documentos/{identificador}/estado": {
      "post": {
        "tags": [
          "fila"
        ],
        "summary": "Avançar um documento na esteira",
        "operationId": "avancar_documento_fila_documentos__identificador__estado_post",
        "parameters": [
          {
            "name": "identificador",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Identificador"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AtualizacaoDeDocumento"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Documento"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AtualizacaoDeDocumento": {
        "properties": {
          "estado": {
            "$ref": "#/components/schemas/EstadoDoDocumento"
          },
          "fornecedor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fornecedor"
          },
          "valor_total": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valor Total"
          },
          "categoria": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Categoria"
          },
          "regra_aplicada": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Regra Aplicada"
          },
          "confianca": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "alta",
                  "media",
                  "baixa"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Confianca"
          },
          "justificativa": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Justificativa"
          }
        },
        "type": "object",
        "required": [
          "estado"
        ],
        "title": "AtualizacaoDeDocumento"
      },
      "DecisaoSobreProposta": {
        "properties": {
          "auditor": {
            "type": "string",
            "minLength": 3,
            "title": "Auditor",
            "description": "Nome de quem está decidindo."
          },
          "motivo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Motivo"
          }
        },
        "type": "object",
        "required": [
          "auditor"
        ],
        "title": "DecisaoSobreProposta"
      },
      "Documento": {
        "properties": {
          "identificador": {
            "type": "string",
            "title": "Identificador"
          },
          "arquivo": {
            "type": "string",
            "title": "Arquivo"
          },
          "recebido_em": {
            "type": "string",
            "format": "date-time",
            "title": "Recebido Em"
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoDoDocumento",
            "default": "recebido"
          },
          "atualizado_em": {
            "type": "string",
            "format": "date-time",
            "title": "Atualizado Em"
          },
          "fornecedor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fornecedor"
          },
          "valor_total": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valor Total"
          },
          "categoria": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Categoria"
          },
          "regra_aplicada": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Regra Aplicada"
          },
          "confianca": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "alta",
                  "media",
                  "baixa"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Confianca"
          },
          "justificativa": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Justificativa"
          },
          "precisa_de_humano": {
            "type": "boolean",
            "title": "Precisa De Humano",
            "default": false
          },
          "historico": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Historico"
          }
        },
        "type": "object",
        "required": [
          "identificador",
          "arquivo",
          "recebido_em",
          "atualizado_em"
        ],
        "title": "Documento"
      },
      "EntradaDeDocumento": {
        "properties": {
          "arquivo": {
            "type": "string",
            "minLength": 1,
            "title": "Arquivo"
          },
          "fornecedor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fornecedor"
          },
          "valor_total": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valor Total"
          }
        },
        "type": "object",
        "required": [
          "arquivo"
        ],
        "title": "EntradaDeDocumento"
      },
      "EntradaDeProposta": {
        "properties": {
          "secao": {
            "$ref": "#/components/schemas/SecaoDaMemoria"
          },
          "texto": {
            "type": "string",
            "maxLength": 400,
            "minLength": 15,
            "title": "Texto"
          },
          "evidencia": {
            "type": "string",
            "maxLength": 400,
            "minLength": 10,
            "title": "Evidencia"
          }
        },
        "type": "object",
        "required": [
          "secao",
          "texto",
          "evidencia"
        ],
        "title": "EntradaDeProposta",
        "description": "O que o agente envia. Repare no que NÃO existe aqui: situação, aprovador, data\nde decisão. O agente não tem como se auto-aprovar porque o contrato não permite."
      },
      "EstadoDeSaude": {
        "properties": {
          "servico": {
            "type": "string",
            "title": "Servico",
            "default": "servico-de-continuidade-do-deva"
          },
          "versao": {
            "type": "string",
            "title": "Versao"
          },
          "armazenamento": {
            "type": "string",
            "title": "Armazenamento"
          },
          "memoria_acessivel": {
            "type": "boolean",
            "title": "Memoria Acessivel"
          },
          "total_de_linhas_na_memoria": {
            "type": "integer",
            "title": "Total De Linhas Na Memoria"
          },
          "propostas_pendentes": {
            "type": "integer",
            "title": "Propostas Pendentes"
          }
        },
        "type": "object",
        "required": [
          "versao",
          "armazenamento",
          "memoria_acessivel",
          "total_de_linhas_na_memoria",
          "propostas_pendentes"
        ],
        "title": "EstadoDeSaude"
      },
      "EstadoDoDocumento": {
        "type": "string",
        "enum": [
          "recebido",
          "extraido",
          "auditado",
          "conforme",
          "excecao",
          "ilegivel",
          "duplicado"
        ],
        "title": "EstadoDoDocumento",
        "description": "A máquina de estados. É ela que transforma pergunta-e-resposta em processo."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LinhaDeMemoria": {
        "properties": {
          "secao": {
            "$ref": "#/components/schemas/SecaoDaMemoria"
          },
          "origem": {
            "type": "string",
            "title": "Origem",
            "description": "Quem disse. Nome do auditor humano, nunca 'Deva'."
          },
          "data": {
            "type": "string",
            "format": "date",
            "title": "Data"
          },
          "texto": {
            "type": "string",
            "title": "Texto"
          },
          "aprovada_por": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aprovada Por"
          },
          "aprovada_em": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aprovada Em"
          }
        },
        "type": "object",
        "required": [
          "secao",
          "origem",
          "data",
          "texto"
        ],
        "title": "LinhaDeMemoria",
        "description": "Uma regra já aprovada, vivendo no MEMORY.md."
      },
      "Memoria": {
        "properties": {
          "atualizada_em": {
            "type": "string",
            "format": "date-time",
            "title": "Atualizada Em"
          },
          "total_de_linhas": {
            "type": "integer",
            "title": "Total De Linhas"
          },
          "linhas": {
            "items": {
              "$ref": "#/components/schemas/LinhaDeMemoria"
            },
            "type": "array",
            "title": "Linhas"
          },
          "markdown": {
            "type": "string",
            "title": "Markdown"
          }
        },
        "type": "object",
        "required": [
          "atualizada_em",
          "total_de_linhas",
          "linhas",
          "markdown"
        ],
        "title": "Memoria",
        "description": "A resposta de GET /memoria — o que o agente lê no início de toda sessão."
      },
      "PropostaDeMemoria": {
        "properties": {
          "identificador": {
            "type": "string",
            "title": "Identificador"
          },
          "secao": {
            "$ref": "#/components/schemas/SecaoDaMemoria"
          },
          "texto": {
            "type": "string",
            "title": "Texto"
          },
          "evidencia": {
            "type": "string",
            "title": "Evidencia",
            "description": "Qual documento e qual correção do auditor motivaram esta proposta."
          },
          "proposta_por": {
            "type": "string",
            "title": "Proposta Por",
            "default": "deva"
          },
          "proposta_em": {
            "type": "string",
            "format": "date-time",
            "title": "Proposta Em"
          },
          "situacao": {
            "$ref": "#/components/schemas/SituacaoDaProposta",
            "default": "pendente"
          },
          "decidida_por": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decidida Por"
          },
          "decidida_em": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decidida Em"
          },
          "motivo_do_descarte": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Motivo Do Descarte"
          }
        },
        "type": "object",
        "required": [
          "identificador",
          "secao",
          "texto",
          "evidencia",
          "proposta_em"
        ],
        "title": "PropostaDeMemoria",
        "description": "Uma regra que o agente QUER aprender. Ainda não vale nada.\n\nO campo `evidencia` é o que separa aprendizado de alucinação: se o agente não\nconsegue apontar o documento e a conversa que motivaram a regra, a proposta não\ndeveria existir."
      },
      "ResumoDaFila": {
        "properties": {
          "gerado_em": {
            "type": "string",
            "format": "date-time",
            "title": "Gerado Em"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "por_estado": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Por Estado"
          },
          "aguardando_o_agente": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Aguardando O Agente",
            "description": "Identificadores em estado que o agente ainda pode avançar."
          },
          "aguardando_humano": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Aguardando Humano",
            "description": "Identificadores parados em exceção. O agente NÃO resolve estes."
          },
          "propostas_pendentes": {
            "type": "integer",
            "title": "Propostas Pendentes"
          }
        },
        "type": "object",
        "required": [
          "gerado_em",
          "total",
          "por_estado",
          "aguardando_o_agente",
          "aguardando_humano",
          "propostas_pendentes"
        ],
        "title": "ResumoDaFila",
        "description": "A resposta que o agente lê para saber o que fazer sem ninguém mandar."
      },
      "SecaoDaMemoria": {
        "type": "string",
        "enum": [
          "classificacao",
          "interpretacao_de_politica",
          "fornecedores",
          "operacao"
        ],
        "title": "SecaoDaMemoria",
        "description": "As seções do MEMORY.md. Lista fechada de propósito.\n\nMemória sem seção vira lista infinita, e lista infinita ninguém revisa."
      },
      "SituacaoDaProposta": {
        "type": "string",
        "enum": [
          "pendente",
          "aprovada",
          "descartada"
        ],
        "title": "SituacaoDaProposta"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
