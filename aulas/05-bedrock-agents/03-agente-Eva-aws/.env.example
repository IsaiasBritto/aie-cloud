# Copie para .env — SÓ PARA RODAR NA SUA MÁQUINA.
#
# Na AWS este arquivo não existe: a task definition do ECS entrega cada um
# destes valores como variável de ambiente, a credencial vem da task role e a
# chave da OpenAI (se usada) vem do Secrets Manager.
# O .dockerignore garante que o .env nunca entre na imagem.

# --- Provedor ---------------------------------------------------------------
# "bedrock" = Amazon Bedrock com a sua credencial AWS. PADRÃO. Sem chave.
# "openai"  = API da OpenAI com chave. Use no Learner Lab, que não libera o Bedrock.
EVA_PROVEDOR=bedrock

# --- Bedrock ----------------------------------------------------------------
AWS_REGION=us-east-1
# AWS_PROFILE=aula-bedrock
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# --- OpenAI (só com EVA_PROVEDOR=openai) ------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Telemetria -------------------------------------------------------------
# "stdout" = uma linha JSON por chamada ao modelo (no ECS, vai ao CloudWatch).
# Vazio na sua máquina = desligada, aplicação roda igual.
EVA_TELEMETRIA=

# Preços do SEU modelo, por 1 milhão de tokens, para o custo estimado.
# Consulte a página de preços do Amazon Bedrock (ou da OpenAI). Deixados em 0
# de propósito: número inventado em painel de custo é pior que painel nenhum.
EVA_PRECO_ENTRADA_POR_1M=0
EVA_PRECO_SAIDA_POR_1M=0

# --- Comportamento do agente ------------------------------------------------
EVA_TEMPERATURA=0.7
EVA_MAX_ITERACOES=5
EVA_MAX_TOKENS=1024
