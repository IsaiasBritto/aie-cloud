# ───────────────────────────────────────────────────────────────────────
# Deva3 · exemplo de configuração
#
# Copie para .env e preencha. O arquivo .env NUNCA vai para o Git.
#   cp .env.exemplo .env
#
# Repare no que NÃO existe aqui: chave de serviço cognitivo. O Rekognition e
# o S3 usam a credencial AWS — na sua máquina, a do Learner Lab; no ECS, a
# role da tarefa (LabRole), entregue pelo próprio ECS.
# ───────────────────────────────────────────────────────────────────────

AMBIENTE=local

# ── AWS ────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Na SUA máquina (fora do CloudShell), cole as três linhas de
# Learner Lab → AWS Details → AWS CLI: Show. Elas expiram com a sessão (4 h).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Confiança mínima (0–100) que o Rekognition usa para devolver uma caixa.
# Não confunda com LIMIAR_CONFIANCA, que é a regra de decisão (0–1).
REKOGNITION_CONFIANCA_MINIMA=50

# ── S3 ─────────────────────────────────────────────────────────────────
# Nome do bucket: output `bucket` do Terraform (bash infra/01-criar-recursos.sh).
# Vazio = não grava nada (a API funciona igual).
ARMAZENAMENTO_BUCKET=
ARMAZENAMENTO_PREFIXO=deteccoes

# Privacidade por padrão: mesmo com PERSISTIR_IMAGENS=true, a imagem só é
# gravada se o usuário marcar o consentimento na tela.
PERSISTIR_IMAGENS=true

# ── Limites operacionais ───────────────────────────────────────────────
TAMANHO_MAXIMO_MB=4
LIMIAR_CONFIANCA=0.60
TEMPO_LIMITE_SEGUNDOS=30
ORIGENS_PERMITIDAS=*

# ── Interface ──────────────────────────────────────────────────────────
# Em execução local com docker compose, use http://api:8000
API_URL=http://localhost:8000
