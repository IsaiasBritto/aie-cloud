# ───────────────────────────────────────────────────────────────────────
# Deva3 · exemplo de configuração
#
# Copie para .env e preencha. O arquivo .env NUNCA vai para o Git.
#   cp .env.exemplo .env
# ───────────────────────────────────────────────────────────────────────

AMBIENTE=local

# ── Azure AI Vision — modo "pessoas" (obrigatório) ─────────────────────
# Portal → seu recurso de Vision → Chaves e Ponto de Extremidade
# O endpoint termina em .cognitiveservices.azure.com, SEM barra no final.
VISAO_ENDPOINT=https://SEU-RECURSO.cognitiveservices.azure.com
VISAO_CHAVE=cole-aqui-a-chave-1
VISAO_API_VERSAO=2024-02-01

# ── Azure AI Face — modo "rostos" (opcional, Acesso Limitado) ──────────
# Deixe em branco se a sua assinatura não tem o recurso Face aprovado.
FACE_ENDPOINT=
FACE_CHAVE=
FACE_MODELO_DETECCAO=detection_03

# ── Blob Storage ───────────────────────────────────────────────────────
# Portal → sua conta de armazenamento → Chaves de acesso → Cadeia de conexão
ARMAZENAMENTO_CONEXAO=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
ARMAZENAMENTO_CONTAINER=deteccoes

# Privacidade por padrão: mesmo com PERSISTIR_IMAGENS=true, a imagem só é
# gravada se o usuário marcar o consentimento na tela.
PERSISTIR_IMAGENS=true

# ── Limites operacionais ───────────────────────────────────────────────
TAMANHO_MAXIMO_MB=4
LIMIAR_CONFIANCA=0.60
TEMPO_LIMITE_SEGUNDOS=30
ORIGENS_PERMITIDAS=*

# ── Interface ──────────────────────────────────────────────────────────
# Em execução local com docker compose, use http://api:8000
API_URL=http://localhost:8000
