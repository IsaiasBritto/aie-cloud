# Copie para .env e ajuste. Onde achar cada valor: veja o GUIA-BEDROCK.md.
#
# Repare no que NÃO existe aqui: chave de API. No Bedrock quem assina a
# requisição é a sua credencial AWS (aws configure / aws sso login), e quem
# autoriza é a política IAM. Nenhum segredo da aplicação mora neste arquivo.
#
# ATENÇÃO: o AWS Academy Learner Lab NÃO libera o Bedrock. Use uma conta comum.

# --- credencial AWS ---------------------------------------------------------
# Deixe comentado para usar o perfil padrão do `aws configure`.
# AWS_PROFILE=aula-bedrock
AWS_REGION=us-east-1

# --- QUAL MODELO USAR ------------------------------------------------------
# ID do PERFIL DE INFERÊNCIA (prefixo us. ou global.) ou do modelo.
# Liste os disponíveis com:
#   aws bedrock list-inference-profiles --query "inferenceProfileSummaries[].inferenceProfileId"
# Exemplos:
#   us.amazon.nova-lite-v1:0                       (barato, sem formulário)
#   us.amazon.nova-pro-v1:0
#   us.anthropic.claude-haiku-4-5-20251001-v1:0    (1º uso pede o formulário da Anthropic)
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# --- comportamento do agente -----------------------------------------------
EVA_TEMPERATURA=0.7
EVA_MAX_ITERACOES=5
EVA_MAX_TOKENS=1024
