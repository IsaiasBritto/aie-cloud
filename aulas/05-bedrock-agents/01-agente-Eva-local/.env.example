# Copie este arquivo para .env e preencha.

#OPENAI_API_KEY=sk-proj-...
OPENAI_API_KEY=

# Modelo da OpenAI usado pela Eva.
OPENAI_MODEL=gpt-4o-mini

# 0.0 = objetiva e previsível | 1.0 = criativa e variada
EVA_TEMPERATURA=0.7

# Quantas rodadas de ferramenta ela pode fazer antes de responder.
EVA_MAX_ITERACOES=5
